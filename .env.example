# Base URL para chamadas à API (mesmo origin).
# Em dev o Vite faz proxy de /api para o backend (vite.config.ts).
# Não commitar .env com valores reais.
VITE_API_BASE_URL=/api
# Opcional (dev): backend real para o proxy local.
# Ex.: http://localhost:8000 | https://serveremplyon.cloud
VITE_DEV_PROXY_TARGET=http://localhost

# --- Produção na Vercel ---
# Mantém VITE_API_BASE_URL=/api (ou não definas — o código usa /api por defeito).
# O browser fala só com o teu domínio (ex. www.emplyon.com); o vercel.json faz
# rewrite de /api/* → https://serveremplyon.cloud/api/* (sem CORS no browser).
# NÃO uses só https://serveremplyon.cloud sem o sufixo /api — os pedidos iam para
# /login em vez de /api/login.
# Na Vercel: Root Directory = pasta do frontend (onde está vercel.json), se o repo tiver mais pastas.
