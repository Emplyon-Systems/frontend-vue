# Base URL para chamadas à API (mesmo origin).
# Em dev o Vite faz proxy de /api para o backend (vite.config.ts).
# Não commitar .env com valores reais.
VITE_API_BASE_URL=/api
# Opcional (dev): backend real para o proxy local.
# Ex.: http://localhost:8000 | https://serveremplyon.cloud
VITE_DEV_PROXY_TARGET=http://localhost
